<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Custom Canvas HUD (Reticles, Level, 1m Frame, Badges) -->
    <com.texelcam.app.TexelHudView
        android:id="@+id/hudView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Guidance & Status Card -->
    <LinearLayout
        android:id="@+id/topCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_control_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLiveDensity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="TD: 2048 px/m"
                android:textColor="@color/accent_neon_cyan"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Dist: 0.85 m"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="HOLD PERPENDICULAR TO SURFACE"
            android:textColor="@color/accent_neon_yellow"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Thumb-Friendly Control Bar -->
    <LinearLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_control_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Target Density Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDensity512"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="512"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDensity1024"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="1024"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDensity2048"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_selected"
                android:fontFamily="sans-serif-bold"
                android:text="2048"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDensity4096"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="4096"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Distance fine calibration slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDistLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual / Override:"
                android:textColor="@color/hud_text_dim"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sbDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="250"
                android:progress="85" />

            <TextView
                android:id="@+id/tvManualDistVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.85m"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Pro Features Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnAeAfLock"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="AE/AF UNLOCKED"
                android:textColor="@color/white"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btnAutoCapture"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="AUTO: OFF"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>


        <!-- Main Bottom Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mode Switch (Wall vs Floor) -->
            <Button
                android:id="@+id/btnSurfaceMode"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="WALL"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Shutter Button -->
            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_shutter"
                android:contentDescription="Capture Texture" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Torch / Flashlight Toggle -->
            <Button
                android:id="@+id/btnTorch"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_unselected"
                android:fontFamily="sans-serif-bold"
                android:text="LIGHT"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
